{
  "buildCommand": "npm --prefix client install && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "routes": [
    {
      "src": "^/api/auth/login$",
      "dest": "/api/auth/login.js"
    },
    {
      "src": "^/api/auth/me$",
      "dest": "/api/auth/me.js"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
